# Copy this file to .env and fill in your values.
# Each user needs their own ESPACE_API_KEY — the key identifies the user
# to eSpace's audit trail. Do NOT share a key across users.

# Required — your personal eSpace API key (UUID format)
ESPACE_API_KEY=

# Optional — override the eSpace API base URL
# ESPACE_BASE_URL=https://api.espace.cool
